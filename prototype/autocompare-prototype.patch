+      left += value;
+      return seg;
+    }).filter(s => s.value > 0).map((s, i) => {
+      const share = x.r.total ? Math.round((s.value / x.r.total) * 100) : 0;
+      const tip = `<strong>${esc(x.name)}</strong><br><i class="key" style="background:${s.c.color}"></i>${s.c.label}: ${money(s.value)} (${share}%)`;
