+    if (!collide) {
+      valid.forEach(v => {
+        const name = v.name.length > 18 ? `${v.name.slice(0, 17)}…` : v.name;
+        svg += `<text class="end-label" x="${x(M) + 10}" y="${y(v.cash) - 2}">${esc(name)}</text>`;
+        svg += `<text class="end-value" x="${x(M) + 10}" y="${y(v.cash) + 13}">${money0(v.cash)}</text>`;
+      });
+    }
+  }
