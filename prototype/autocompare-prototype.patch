+
+// "Nice" axis step: 1, 2, 2.5 or 5 times a power of ten.
+function niceStep(range, count) {
+  const raw = range / count;
+  const pow = 10 ** Math.floor(Math.log10(raw));
+  const f = raw / pow;
+  return (f <= 1 ? 1 : f <= 2 ? 2 : f <= 2.5 ? 2.5 : f <= 5 ? 5 : 10) * pow;
